# Sample systemd service file for bluestation-bs
#
#
# Usage:
# - start service with "systemctl start bluestation-bs"
# - show state with "systemctl status bluestation-bs"
# - stop service with "systemctl stop bluestation-bs"
# - to enable start at boot, execute: "systemctl enable bluestation-bs"
# - to disable start at boot, execute: "systemctl disable bluestation-bs"
# - see log with "journalctl -u bluestation-bs --output=cat -f"

[Unit]
Description=TETRA BlueStation base station service
# network-online.target ensures the interface is UP and routable,
# not just "declared active" like network.target.
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root
Type=simple
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=73
WorkingDirectory=/opt/tetra-bluestation/

# Reset the SXceiver/SoapySDR USB device before each start to prevent
# stale hardware timestamp state causing "Too late to produce TX block" skips
# on software restarts (as opposed to hard power cycles).
# This unbinds and rebinds the USB device, forcing a clean hardware reset.
ExecStart=/opt/tetra-bluestation/target/release/bluestation-bs /opt/tetra-bluestation/config.toml
KillSignal=SIGINT

# Restart automatically on crash or unexpected exit.
# on-failure covers: non-zero exit, killed by signal, timeout.
# Does NOT restart on clean exit (systemctl stop) or SIGINT (graceful shutdown).
Restart=on-failure
RestartSec=10

# Remove start rate limiting entirely — let RestartSec govern the pace.
# Without this, systemd stops trying after 5 restarts in 10s (the default).
StartLimitIntervalSec=5

[Install]
WantedBy=multi-user.target
